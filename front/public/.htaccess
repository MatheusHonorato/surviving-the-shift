<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Se for um arquivo ou diretório existente, usa normalmente
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Caso contrário, redireciona tudo para index.html (SPA fallback)
  RewriteRule . /index.html [L]
</IfModule>
